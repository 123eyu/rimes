#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/ui/product_icon.h"

// Keep the full mascot first and the black horn second. The TSF registrar
// selects the second icon group for the language-bar profile icon.
IDI_RIMES ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/rimes.ico"
IDI_RIMES_HORN_BLACK ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/rhino-horn-black.ico"
IDI_RIMES_HORN_WHITE ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/rhino-horn-white.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @RIMES_RESOURCE_TYPE@
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RIMES Windows\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "OriginalFilename", "@RIMES_RESOURCE_FILENAME@\0"
            VALUE "ProductName", "RIMES\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
